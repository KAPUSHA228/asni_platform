# Скопируйте в .env и при необходимости поменяйте.

# Общий секрет JWT для Java-сервисов АСНИ (auth, gateway, survey, storage, analytics)
JWT_SECRET=changeme-replace-in-production-256bit-secret-key!!
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=Admin@1234!

# Секреты подсистем со своей авторизацией (до объединения auth)
CONSTRUCTOR_JWT_SECRET=changeme
CREATIVITY_SECRET_KEY=change_me
CREATIVITY_ST_MODEL=paraphrase-multilingual-mpnet-base-v2

# Порты на хосте
LANDING_PORT=80
GATEWAY_PORT=8080
ML_PORT=8101
CREATIVITY_PORT=8102
SURVEY_PORT=8103
RAY_DASHBOARD_PORT=8265

# Ресурсы Ray (на слабой машине поставьте 2)
RAY_CPUS=4
